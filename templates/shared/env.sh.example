# Fleet secrets. Copy to env.sh, chmod 600, and NEVER commit it.
# Every agent sources this file as its first step.

# Where the fleet lives (each agent is a folder here)
export AGENTS_HOME="$HOME/agents"

# Telegram: create a bot with @BotFather, get your chat id from @userinfobot
export TELEGRAM_TOKEN=""
export TELEGRAM_CHAT_ID=""

# Cron strips your PATH. Add anything your agents call that lives outside
# /usr/bin (the Claude CLI often lands in ~/.local/bin or ~/.npm-global/bin).
export PATH="$PATH:$HOME/.local/bin:$HOME/.npm-global/bin"

# Add your own API keys below as: export MY_KEY=""
